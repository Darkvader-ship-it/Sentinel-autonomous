# Copy this file to .env and provide real values.
# Vite only exposes variables prefixed with VITE_.

# SoSoValue market data API (src/lib/market-ingestion.ts)
# Used by fetchSoSoValueContext() to pull live market narrative, prices, and events.
SOSOVALUE_API_URL=
SOSOVALUE_API_KEY=

# SoDEX execution client (src/lib/dex-sodex.ts)
# When both are set, the app routes trades through live SoDEX API instead of mock data.
VITE_SODEX_API_URL=
VITE_SODEX_API_KEY=

# RPC endpoints for live wallet portfolio (src/hooks/use-wallet-portfolio.ts)
# Uses public fallbacks if not set
VITE_ETH_RPC_URL=
VITE_SOL_RPC_URL=
