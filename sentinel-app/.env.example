# =============================================================================
# Sentinel Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# ─── SoSoValue API (ETF flow data, market narrative, macro events) ───────────
# Required for live ETF flow data. Without a valid key the system falls back to
# BTC-price-based proxy estimates.
#
# 1. Register at https://www.sosovalue.com/ (API Open Platform)
# 2. Generate an API key from your dashboard
# 3. Set it here:
SOSOVALUE_API_KEY=
#
# Optional: custom base URL (defaults to openapi.sosovalue.com paths)
# SOSOVALUE_API_URL=https://openapi.sosovalue.com/openapi/v1

# ─── SoDEX execution client (src/lib/dex-sodex.ts) ──────────────────────────
# When both are set the app routes trades through live SoDEX API.
# Omit or leave empty to use mock execution.
VITE_SODEX_API_URL=
VITE_SODEX_API_KEY=

# ─── Privy authentication (src/lib/auth.tsx) ────────────────────────────────
# Required. Get your app ID from https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# ─── RPC endpoints ──────────────────────────────────────────────────────────
# Optional. Uses public fallbacks if not set.
# VITE_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# VITE_SOL_RPC_URL=https://api.mainnet-beta.solana.com
