# Copy this file to .env and provide real values.
# Vite only exposes variables prefixed with VITE_.

VITE_PRIVY_APP_ID=cmp1jhxx0010g0bl9pc4apb1y
# Optional: used by market ingestion adapter for live SoSoValue API data.
SOSOVALUE_API_URL=https://openapi.sosovalue.com/openapi/v1
SOSOVALUE_API_KEY=SOSO-79f9acb967e448bd92178501a3d3de3a

# SoDEX execution client (src/lib/dex-sodex.ts)
# When both are set, the app routes trades through live SoDEX API instead of mock data.
VITE_SODEX_API_URL=https://testnet-gw.sodex.dev/api/v1/spot
VITE_SODEX_API_KEY=test

# RPC endpoints for live wallet portfolio (src/hooks/use-wallet-portfolio.ts)
# Uses public fallbacks if not set
VITE_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_SOL_RPC_URL=https://api.mainnet-beta.solana.com
