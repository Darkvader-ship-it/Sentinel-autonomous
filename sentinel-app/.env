# Privy authentication (REQUIRED)
VITE_PRIVY_APP_ID=cmp1jhxx0010g0bl9pc4apb1y

# SoSoValue API — register at https://www.sosovalue.com/ to get a valid key
# The key below is INVALID and MUST be replaced for live ETF flow data.
# Without it, the system uses BTC-price-based proxy estimates.
SOSOVALUE_API_KEY=

# SoDEX execution client (disabled — using mock client)
# VITE_SODEX_API_URL=https://testnet-gw.sodex.dev/api/v1/spot
# VITE_SODEX_API_KEY=test

# RPC endpoints (uses public fallbacks if not set)
VITE_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_SOL_RPC_URL=https://api.mainnet-beta.solana.com
